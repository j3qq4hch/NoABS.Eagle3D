#usage "Export board textures and generate 3D GLB model.\n\
Usage:\n\
  RUN export3D.ulp       -- run silently if already configured, else show dialog\n\
  RUN export3D.ulp SET   -- always show settings dialog\n\
  RUN export3D.ulp OPEN  -- generate and open result in system viewer"

string win_path(string s)
{
  string result = s;
  int i;
  for (i = 0; result[i]; i++)
    if (result[i] == '/') result[i] = '\\';
  return result;
}

string read_ini_value(string ini_path, string key)
{
  string lines[];
  int n = fileread(lines, ini_path);
  int klen = strlen(key);
  string result = "";
  int i;
  for (i = 0; i < n; i++)
  {
    if (strsub(lines[i], 0, klen + 1) == key + "=")
    {
      result = strsub(lines[i], klen + 1);
      int rlen = strlen(result);
      if (rlen > 0 && result[rlen-1] == '\n') { result[rlen-1] = '\0'; rlen--; }
      if (rlen > 0 && result[rlen-1] == '\r') { result[rlen-1] = '\0'; }
    }
  }
  return result;
}

void main()
{
  string board_dir, brd_stem, brd_full, tmp_dir, textures_dir;
  string scripts_dir, settings_ini, ini_path, step2_path;
  string glb_dir, dpi_str, cmd, s, v;
  string mp_save, mc_save, fc_save, sc_save, dpi_save;
  int min_priority, mask_choice, finish_choice, silk_choice, dpi, merge;
  int set_mode, open_mode, show_dialog, slen, ci, i, p, aa, rr, gg, bb;
  int r_mask, g_mask, b_mask, r_cu, g_cu, b_cu;
  int r_fin, g_fin, b_fin, r_silk, g_silk, b_silk;
  int saved_pal[], saved_col[];
  string mask_names[], finish_names[], silk_names[];
  int mask_color[], copper_color[], finish_color[], silk_color[];

  if (!board) { dlgMessageBox("Error: no .brd file is open."); exit(1); }

  // ── Board paths ─────────────────────────────────────────────────────────────
  board(B)
  {
    board_dir    = filedir(B.name);
    brd_stem     = filesetext(filename(B.name), "");
    brd_full     = B.name;
    tmp_dir      = board_dir + "NoABS_tmp/";
    textures_dir = tmp_dir + brd_stem + "_textures/";
  }

  scripts_dir  = filedir(argv[0]);
  settings_ini = tmp_dir + "export3d_settings.ini";

  // ── Color presets ────────────────────────────────────────────────────────────
  mask_names[0] = "Green";   mask_color[0] = 0x1A7C0F; copper_color[0] = 0x298D29;
  mask_names[1] = "Blue";    mask_color[1] = 0x1A18BF; copper_color[1] = 0x2828D8;
  mask_names[2] = "Red";     mask_color[2] = 0x9F180F; copper_color[2] = 0xAE2929;
  mask_names[3] = "Black";   mask_color[3] = 0x1A180F; copper_color[3] = 0x292929;
  mask_names[4] = "Purple";  mask_color[4] = 0x9F1873; copper_color[4] = 0xAE298D;
  mask_names[5] = "White";   mask_color[5] = 0xE2E0D7; copper_color[5] = 0xF1F1F1;

  finish_names[0] = "ENIG (gold)"; finish_color[0] = 0xD4AF37;
  finish_names[1] = "HASL (tin)";  finish_color[1] = 0xC0C0C0;

  silk_names[0] = "White"; silk_color[0] = 0xFEFEFE;
  silk_names[1] = "Black"; silk_color[1] = 0x010101;

  // ── Defaults ─────────────────────────────────────────────────────────────────
  glb_dir       = "";
  min_priority  = 0;
  mask_choice   = 0;
  finish_choice = 0;
  silk_choice   = 0;
  dpi           = 400;
  merge         = 0;

  set_mode    = (argc == 2 && strupr(argv[1]) == "SET");
  open_mode   = (argc == 2 && strupr(argv[1]) == "OPEN");
  show_dialog = set_mode || (filesize(settings_ini) <= 0);

  // ── Load saved settings ────────────────────────────────────────────────────
  if (filesize(settings_ini) > 0)
  {
    v = read_ini_value(settings_ini, "glb_dir");      if (strlen(v)) glb_dir       = v;
    v = read_ini_value(settings_ini, "min_priority"); if (strlen(v)) min_priority  = strtol(v);
    v = read_ini_value(settings_ini, "mask_choice");  if (strlen(v)) mask_choice   = strtol(v);
    v = read_ini_value(settings_ini, "finish_choice");if (strlen(v)) finish_choice = strtol(v);
    v = read_ini_value(settings_ini, "silk_choice");  if (strlen(v)) silk_choice   = strtol(v);
    v = read_ini_value(settings_ini, "dpi");          if (strlen(v)) dpi           = strtol(v);
    v = read_ini_value(settings_ini, "merge");        if (strlen(v)) merge         = strtol(v);
  }

  // ── Dialog ───────────────────────────────────────────────────────────────────
  if (show_dialog)
  {
    if (dlgDialog("Export 3D")
    {
      dlgGroup("Solder mask")
      {
        dlgComboBox(mask_names, mask_choice);
      }
      dlgGroup("Pad finish")
      {
        dlgComboBox(finish_names, finish_choice);
      }
      dlgGroup("Silkscreen")
      {
        dlgComboBox(silk_names, silk_choice);
      }
      dlgHBoxLayout
      {
        dlgLabel("DPI:"); dlgIntEdit(dpi, 72, 2400); dlgStretch(1);
      }
      dlgGroup("Components (optional)")
      {
        dlgHBoxLayout
        {
          dlgLabel("GLB dir:");
          dlgStringEdit(glb_dir);
          dlgPushButton("...") glb_dir = dlgDirectory("Select GLB components directory", glb_dir);
        }
        dlgHBoxLayout
        {
          dlgLabel("Min Priority3d:");
          dlgIntEdit(min_priority, 0, 9999);
          dlgStretch(1);
        }
        dlgCheckBox("Merge components by material", merge);
      }
      dlgHBoxLayout
      {
        dlgPushButton("+OK")     dlgAccept();
        dlgPushButton("-Cancel") dlgReject();
      }
    } != 1)
      exit(0);
  }

  if (dpi <= 0) dpi = 400;

  // ── Save settings ────────────────────────────────────────────────────────────
  sprintf(mp_save,  "%d", min_priority);
  sprintf(mc_save,  "%d", mask_choice);
  sprintf(fc_save,  "%d", finish_choice);
  sprintf(sc_save,  "%d", silk_choice);
  sprintf(dpi_save, "%d", dpi);
  output(settings_ini, "wt")
  {
    printf("glb_dir=%s\n",        glb_dir);
    printf("min_priority=%s\n",   mp_save);
    printf("mask_choice=%s\n",    mc_save);
    printf("finish_choice=%s\n",  fc_save);
    printf("silk_choice=%s\n",    sc_save);
    printf("dpi=%s\n",            dpi_save);
    printf("merge=%d\n",          merge);
  }

  // ── Create working dirs and clear previous textures (single cmd call) ────────
  system("cmd.exe /c mkdir \"" + win_path(tmp_dir) + "\" 2>nul"
       + " & mkdir \"" + win_path(textures_dir) + "\" 2>nul"
       + " & del /f /q \"" + win_path(textures_dir) + "top_texture.bmp\" 2>nul"
       + " & del /f /q \"" + win_path(textures_dir) + "bottom_texture.bmp\" 2>nul");

  // ── ini for step2 ─────────────────────────────────────────────────────────────
  ini_path = tmp_dir + "export3d.ini";
  output(ini_path, "wt")
  {
    printf("brd_full=%s\n",      brd_full);
    printf("tmp_dir=%s\n",       tmp_dir);
    printf("brd_stem=%s\n",      brd_stem);
    printf("glb_dir=%s\n",       glb_dir);
    printf("min_priority=%d\n",  min_priority);
    printf("merge=%d\n",         merge);
  }

  // ── Extract RGB from presets ─────────────────────────────────────────────────
  r_mask = (mask_color[mask_choice]     >> 16) & 0xFF;
  g_mask = (mask_color[mask_choice]     >>  8) & 0xFF;
  b_mask =  mask_color[mask_choice]            & 0xFF;

  r_cu   = (copper_color[mask_choice]   >> 16) & 0xFF;
  g_cu   = (copper_color[mask_choice]   >>  8) & 0xFF;
  b_cu   =  copper_color[mask_choice]          & 0xFF;

  r_fin  = (finish_color[finish_choice] >> 16) & 0xFF;
  g_fin  = (finish_color[finish_choice] >>  8) & 0xFF;
  b_fin  =  finish_color[finish_choice]        & 0xFF;

  r_silk = (silk_color[silk_choice]     >> 16) & 0xFF;
  g_silk = (silk_color[silk_choice]     >>  8) & 0xFF;
  b_silk =  silk_color[silk_choice]            & 0xFF;

  // ── Save current palette and layer colors ────────────────────────────────────
  for (i = 0; i < 64; i++)
    saved_pal[i] = palette(i);
  board(B) {
    B.layers(L) saved_col[L.number] = L.color;
  }

  // ── Eagle commands ────────────────────────────────────────────────────────────
  sprintf(dpi_str, "%d", dpi);

  cmd  = "EDIT .sch;\n";
  cmd += "VARIANT '';\n";
  cmd += "edit .brd;\n";
  cmd += "ratsnest;\n";
  if (EAGLE_VERSION >= 9)
  {
    cmd += "set Option.SignalNamesOnPads 0;\n";
    cmd += "set Option.SignalNamesOnTraces 0;\n";
  }
  cmd += "set Option.ViaLength 0;\n";
  cmd += "set PAD_NAMES OFF;\n";
  cmd += "SET FILL_LAYER 29 1;\n";
  cmd += "SET FILL_LAYER 30 1;\n";

  // Palette 0  = background = mask color
  // Palette 16 = pad finish (tStop / bStop)
  // Palette 17 = copper under mask
  // Palette 18 = silkscreen
  // Palette 19 = magenta marker for board outline (layer 20), used by Python to crop
  sprintf(s, "SET PALETTE 0  0x%02X%02X%02X%02X;\n", 0xFF, r_mask, g_mask, b_mask); cmd += s;
  sprintf(s, "SET PALETTE 16 0x%02X%02X%02X%02X;\n", 0xFF, r_fin,  g_fin,  b_fin);  cmd += s;
  sprintf(s, "SET PALETTE 17 0x%02X%02X%02X%02X;\n", 0xFF, r_cu,   g_cu,   b_cu);   cmd += s;
  sprintf(s, "SET PALETTE 18 0x%02X%02X%02X%02X;\n", 0xFF, r_silk, g_silk, b_silk); cmd += s;
  cmd += "SET PALETTE 19 0xFFFF00FF;\n";
  cmd += "SET COLOR_LAYER 20 19;\n";

  // ── Top texture ───────────────────────────────────────────────────────────────
  cmd += "SET COLOR_LAYER 29 16;\n";
  cmd += "SET COLOR_LAYER 1  17;\n";
  cmd += "SET COLOR_LAYER 18 17;\n";
  cmd += "SET COLOR_LAYER 19 17;\n";
  cmd += "SET COLOR_LAYER 21 18;\n";
  cmd += "SET Option.LayerSequence 20 21 29 1 18 19;\n";
  cmd += "DISPLAY NONE;\n";
  cmd += "DISPLAY 1 18 19 20 21 29;\n";
  sprintf(s, "EXPORT IMAGE '%s' %s;\n", textures_dir + "top_texture.bmp", dpi_str);
  cmd += s;

  // ── Bottom texture ────────────────────────────────────────────────────────────
  cmd += "SET COLOR_LAYER 30 16;\n";
  cmd += "SET COLOR_LAYER 16 17;\n";
  cmd += "SET COLOR_LAYER 17 17;\n";
  cmd += "SET COLOR_LAYER 18 17;\n";
  cmd += "SET COLOR_LAYER 22 18;\n";
  cmd += "SET Option.LayerSequence 20 22 30 16 17 18;\n";
  cmd += "DISPLAY NONE;\n";
  cmd += "DISPLAY 16 17 18 20 22 30;\n";
  sprintf(s, "EXPORT IMAGE '%s' %s;\n", textures_dir + "bottom_texture.bmp", dpi_str);
  cmd += s;

  // ── Restore palette and layer colors ─────────────────────────────────────────
  for (i = 0; i < 64; i++) {
    p  = saved_pal[i];
    aa = (p >> 24) & 0xFF;
    rr = (p >> 16) & 0xFF;
    gg = (p >>  8) & 0xFF;
    bb =  p        & 0xFF;
    sprintf(s, "SET PALETTE %d 0x%02X%02X%02X%02X;\n", i, aa, rr, gg, bb);
    cmd += s;
  }
  board(B) {
    B.layers(L) {
      sprintf(s, "SET COLOR_LAYER %d %d;\n", L.number, saved_col[L.number]);
      cmd += s;
    }
  }

  // ── Restore display ───────────────────────────────────────────────────────────
  cmd += "DISPLAY NONE;\n";
  if (EAGLE_VERSION >= 9)
  {
    cmd += "set Option.SignalNamesOnPads 1;\n";
    cmd += "set Option.SignalNamesOnTraces 1;\n";
  }
  cmd += "set PAD_NAMES ON;\n";
  cmd += "DISPLAY 20 17 18 1 21 23 25;\n";

  // ── Launch step2 ──────────────────────────────────────────────────────────────
  step2_path = scripts_dir;
  slen = strlen(step2_path);
  if (slen > 0 && step2_path[slen-1] != '/' && step2_path[slen-1] != '\\')
    step2_path += "/";
  for (ci = 0; step2_path[ci]; ci++)
    if (step2_path[ci] == '\\') step2_path[ci] = '/';
  step2_path += "export3D_raw_step2.ulp";

  string open_flag; sprintf(open_flag, "%d", open_mode);
  cmd += "RUN '" + step2_path + "' '" + ini_path + "' '0' '" + open_flag + "';\n";

  exit(cmd);
}
